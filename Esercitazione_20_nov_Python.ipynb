        "def build_gradebooks(records):\n",
        "    esiti = {}\n",
        "    for r in records:\n",
        "        if r[0] not in esiti:\n",
        "            esiti[r[0]] = {r[1]:r[2]}\n",
        "        elif esiti[r[0]].get(r[1],None) is not None:\n",
        "            if esiti[r[0]][r[1]] < r[2]:\n",
        "                esiti[r[0]][r[1]] = r[2]\n",
        "        else:\n",
        "            esiti[r[0]][r[1]]=r[2]\n",
        "    return esiti\n",
        "\n",
        "def summarise_student(esiti, materie_obbligatorie):\n",
        "\n",
        "    esito_finale = []\n",
        "\n",
        "    for studente in esiti.keys():\n",
        "        superamento = True\n",
        "        if not set(esiti[studente].keys()) >= set(materie_obbligatorie):\n",
        "            superamento = False\n",
        "        voti_materie = []\n",
        "        for materia in esiti[studente].keys():\n",
        "            if materia in materie_obbligatorie:\n",
        "                if esiti[studente][materia] < 18:\n",
        "                    superamento = False\n",
        "                else:\n",
        "                    voti_materie.append(esiti[studente][materia])\n",
        "        media = sum(voti_materie)/len(voti_materie) if len(voti_materie) > 0 else None\n",
        "        esito_finale.append((studente,media, superamento))\n",
        "    esito_finale.sort(key = lambda x: x[0])\n",
        "    return esito_finale\n",
        "\n",
        "\n",
        "records=((\"Nicholas\", \"AI\", 20),\n",
        "         (\"Chiara\", \"AI\", 24),\n",
        "         (\"Matteo\", \"ML\", 30),\n",
        "         (\"Nicholas\", \"ML\", 23),\n",
        "         (\"Nicholas\", \"ML\", 30),\n",
        "         (\"Nicholas\", \"ML\", 23),\n",
        "         (\"Matteo\", \"AI\", 25),\n",
        "         (\"Nicholas\", \"Python\", 7),\n",
        "         (\"Nicholas\", \"Python\", 27))\n",
        "\n",
        "materie_obbligatorie = (\"AI\", \"ML\", \"Python\")\n",
        "\n",
