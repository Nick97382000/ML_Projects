        "def valore_magazzino(prodotti):\n",
        "    valore_prodotti = {}\n",
        "    for p in prodotti:\n",
        "        if p[\"nome\"] not in valore_prodotti:\n",
        "            valore_prodotti[p[\"nome\"]] = [p[\"prezzo\"],p[\"prezzo\"]*p[\"quantita\"]]\n",
        "        elif p[\"prezzo\"] != valore_prodotti[p[\"nome\"]][0]:\n",
        "            raise ValueError (\"Prezzo differente per stesso prodotto\")\n",
        "        else:\n",
        "            valore_prodotti[p[\"nome\"]][1] += p[\"prezzo\"]*p[\"quantita\"]\n",
        "\n",
        "    for p in valore_prodotti.keys():\n",
        "        valore_prodotti[p] = valore_prodotti[p][1]\n",
        "    return valore_prodotti\n",
        "\n",
        "prodotti=[{\"nome\":\"pasta\", \"prezzo\":3.5, \"quantita\":5},\n",
        "          {\"nome\":\"salsa\", \"prezzo\":2, \"quantita\":10},\n",
        "          {\"nome\":\"aglio\", \"prezzo\":0.5, \"quantita\":20},\n",
        "          {\"nome\":\"pasta\", \"prezzo\":3.5, \"quantita\":6}]\n",
        "\n",
        "print(valore_magazzino(prodotti))"
