      "source": [
        "def prenota(posti, corso):\n",
        "    if posti.get(corso, None) != None :\n",
        "        if posti.get(corso) > 0:\n",
        "            posti[corso] -= 1\n",
        "            print(\"Posto prenotato per\", corso)\n",
        "        else:\n",
        "            print(\"Non ci sono posti disponibili per\", corso)\n",
        "    else:\n",
        "        print(corso, \"non esiste\")\n",
        "\n",
        "posti = {\"Python\": 3, \"SQL\": 0, \"AI\": 2}\n",
        "prenota(posti, \"Python\")\n",
        "print(posti)\n",
        "prenota(posti,\"SQL\")\n",
        "print(posti)\n",
        "prenota(posti,\"Mate\")\n",
        "print(posti)"
      ],
